# Copy to .env and fill in. .env is gitignored; this file is committed.
RW_RELEASE_SOURCE=fake            # fake | github
RW_POLL_INTERVAL_SECONDS=900      # minimum 10
RW_STORE_TYPE=sqlite              # sqlite | inmemory (inmemory loses data on restart)
RW_DB_PATH=releases.db            # used when RW_STORE_TYPE=sqlite
RW_GITHUB_TOKEN=                  # optional; raises GitHub's rate limit from 60 to 5000 req/h
